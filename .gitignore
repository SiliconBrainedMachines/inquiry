code/paper/*.blg
code/paper/*.fdb_latexmk
code/paper/*.fls
code/paper/*.log
code/paper/*.out
code/paper/*.synctex.gz
code/paper/*.pdf
code/paper/output/*.synctex.gz
!code/paper/output/*.pdf
